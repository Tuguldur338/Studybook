tsx
const SAVED_CLASSES_SEEDED_KEY = "studybook-saved-classes-seeded-v1";

/** Click-to-open details card state for the timetable. */
function useDetailsCard() {
  const [active, setActive] = useState<{
    id: string;
    rect: DOMRect;
  } | null>(null);
  const timerRef = useRef<number | null>(null);

  const cancelClose = useCallback(() => {
    if (timerRef.current !== null) {
      window.clearTimeout(timerRef.current);
      timerRef.current = null;
    }
  }, []);

  const open = useCallback(
    (id: string, element: HTMLElement, delay = 0) => {
      cancelClose();
      const show = () =>
        setActive({ id, rect: element.getBoundingClientRect() });
      if (delay > 0) timerRef.current = window.setTimeout(show, delay);
      else show();
    },
    [cancelClose],
  );

  // A short grace period lets the cursor travel from the subject onto the
  // card without it closing in between.
  const scheduleClose = useCallback(() => {
    cancelClose();
    timerRef.current = window.setTimeout(() => setActive(null), 180);
  }, [cancelClose]);

  const close = useCallback(() => {
    cancelClose();
    setActive(null);
  }, [cancelClose]);

  // Clear any pending timer when the page unmounts.
  useEffect(() => cancelClose, [cancelClose]);

  useEffect(() => {
    if (!active) return;
    const dismiss = () => setActive(null);
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") dismiss();
    };
    // Tapping/clicking anywhere else dismisses it (needed on touch screens).
    const onPointerDown = (event: PointerEvent) => {
      const target = event.target as Element | null;
      if (!target?.closest?.(".time-block, .day-class, .class-popover"))
        dismiss();
    };
    window.addEventListener("scroll", dismiss, true);
    window.addEventListener("resize", dismiss);
    window.addEventListener("keydown", onKeyDown);
    document.addEventListener("pointerdown", onPointerDown);
    return () => {
      window.removeEventListener("scroll", dismiss, true);
      window.removeEventListener("resize", dismiss);
      window.removeEventListener("keydown", onKeyDown);
      document.removeEventListener("pointerdown", onPointerDown);
    };
  }, [active]);

  return { active, open, close, scheduleClose, cancelClose };
}

export function ScheduleView() {
  const {
    classChecks,
    classes,
    deleteClass,
    deleteSavedClass,
    isLoaded,
    notify,
    savedClasses,
    setClassChecks,
    setClasses,
    setSavedClasses,
  } = useStudybook();
  const { user } = useSupabaseUser();
  const [formOpen, setFormOpen] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [form, setForm] = useState(emptyClassForm);
  const [formError, setFormError] = useState("");
  const [deleteId, setDeleteId] = useState<string | null>(null);
  const {
    active: activeBlock,
    open: openDetails,
    close: closeDetails,
    scheduleClose: scheduleCloseDetails,
    cancelClose: clearPopoverTimer,
  } = useDetailsCard();

  // Day that is widened in the desktop timetable (header + subjects together).
  // It stays widened while one of its cards is open.
  const [hoverDay, setHoverDay] = useState<number | null>(null);
  const activeDay = activeBlock
    ? classes.find((item) => item.id === activeBlock.id)?.day
    : undefined;
  const expandedDay = activeDay ?? hoverDay;

  const [todayDay, setTodayDay] = useState<number | null>(null);
  const [weekAnchor, setWeekAnchor] = useState("");
  const [weekOffset, setWeekOffset] = useState(0);
  const weekOffsetRef = useRef(0);

  useEffect(() => {
    const frame = window.requestAnimationFrame(() => {
      const now = new Date();
      setTodayDay((now.getDay() + 6) % 7);
      setWeekAnchor(toISODate(startOfWeek(now)));
    });
    return () => window.cancelAnimationFrame(frame);
  }, []);

  useEffect(() => {
    weekOffsetRef.current = weekOffset;
  }, [weekOffset]);

  // Roll onto the new week at midnight while the page stays open.
  useEffect(() => {
    const interval = window.setInterval(() => {
      const now = new Date();
      setTodayDay((now.getDay() + 6) % 7);
      if (weekOffsetRef.current !== 0) return;
      setWeekAnchor((current) => {
        const monday = toISODate(startOfWeek(now));
        return current === monday ? current : monday;
      });
    }, 30_000);
    return () => window.clearInterval(interval);
  }, []);

  // Seed the saved list once from classes that already exist, so a schedule
  // created before this feature still offers reusable entries. A stored marker
  // keeps the list from coming back after the user removes every saved class.
  useEffect(() => {
    if (!isLoaded) return;

    let alreadySeeded = false;
    try {
      alreadySeeded =
        window.localStorage.getItem(SAVED_CLASSES_SEEDED_KEY) === "1";
    } catch {
      // Private mode/storage errors should not block the schedule.
    }
    if (alreadySeeded) return;

    try {
      window.localStorage.setItem(SAVED_CLASSES_SEEDED_KEY, "1");
    } catch {
      // The seed is a convenience; ignore storage failures.
    }

    if (savedClasses.length > 0 || classes.length === 0) return;

    setSavedClasses(
      classes.slice(0, 12).map((item) => ({
        ...item,
        id: createId(),
        savedAt: new Date().toISOString(),
      })),
    );
  }, [classes, isLoaded, savedClasses.length, setSavedClasses]);

  function startEditing(session: ClassSession) {
    setEditingId(session.id);
    setForm({
      subject: session.subject,
      day: String(session.day),
      startTime: session.startTime,
      endTime: session.endTime,
      location: session.location,
      instructor: session.instructor,
    });
    setFormError("");
    setFormOpen(true);
  }

  function closeForm() {
    setFormOpen(false);
    setEditingId(null);
    setForm(emptyClassForm);
    setFormError("");
  }

  function applySavedClass(saved: SavedClass) {
    setForm({
      subject: saved.subject,
      day: String(saved.day),
      startTime: saved.startTime,
      endTime: saved.endTime,
      location: saved.location,
      instructor: saved.instructor,
    });
    setFormError("");
  }

  function removeSavedClass(id: string) {
    deleteSavedClass(id);
    notify("Removed from saved classes.");
  }

  function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (form.endTime <= form.startTime) {
      setFormError("The end time must be later than the start time.");
      return;
    }

    const session: ClassSession = {
      id: editingId ?? createId(),
      subject: form.subject.trim(),
      day: Number(form.day),
      startTime: form.startTime,
      endTime: form.endTime,
      location: form.location.trim(),
      instructor: form.instructor.trim(),
    };

    setClasses((current) =>
      editingId
        ? current.map((item) => (item.id === editingId ? session : item))
        : [...current, session],
    );

    const signature = classSignature(session);
    setSavedClasses((current) =>
      [
        { ...session, id: createId(), savedAt: new Date().toISOString() },
        ...current.filter((item) => classSignature(item) !== signature),
      ].slice(0, 12),
    );
    notify(editingId ? "Class updated." : "Class added.");
    closeForm();
  }

  const sortedClasses = [...classes].sort(
    (a, b) => a.day - b.day || a.startTime.localeCompare(b.startTime),
  );
  const classesByDay = weekdays.map((_, index) =>
    sortedClasses.filter((session) => session.day === index),
  );
  const classLayoutsByDay = classesByDay.map(layoutDayClasses);

  const currentWeekStart = weekAnchor
    ? new Date(`${weekAnchor}T00:00:00`)
    : null;
  const viewedWeekStart = currentWeekStart
    ? addDays(currentWeekStart, weekOffset * 7)
    : null;
  const weekKey = viewedWeekStart ? toISODate(viewedWeekStart) : "";
  const dayDates = viewedWeekStart
    ? weekdays.map((_, index) => addDays(viewedWeekStart, index))
    : [];

  const subjectOptions = useMemo(() => {
    const values = new Set<string>();
    [...savedClasses, ...classes].forEach((item) => {
      const subject = item.subject.trim();
      if (subject) values.add(subject);
    });
    return [...values].sort((a, b) => a.localeCompare(b));
  }, [classes, savedClasses]);

  const locationOptions = useMemo(() => {
    const values = new Set<string>();
    [...savedClasses, ...classes].forEach((item) => {
      const location = item.location.trim();
      if (location) values.add(location);
    });
    return [...values].sort((a, b) => a.localeCompare(b));
  }, [classes, savedClasses]);

  const instructorOptions = useMemo(() => {
    const values = new Set<string>();
    [...savedClasses, ...classes].forEach((item) => {
      const instructor = item.instructor.trim();
      if (instructor) values.add(instructor);
    });
    return [...values].sort((a, b) => a.localeCompare(b));
  }, [classes, savedClasses]);

  const existingSignatures = useMemo(
    () => new Set(classes.map((item) => classSignature(item))),
    [classes],
  );
  const completedWeekChecks = classes.reduce((total, session) => {
    const state =
      classChecks[`${weekKey}:${session.id}`] ??
      { classwork: false, homework: false };
    return total + Number(state.classwork) + Number(state.homework);
  }, 0);
  const totalWeekChecks = classes.length * 2;
  const weekCheckProgress = totalWeekChecks
    ? Math.round((completedWeekChecks / totalWeekChecks) * 100)
    : 0;
  const checklistDayStats = classesByDay.map((dayClasses) => {
    const completedChecks = dayClasses.reduce((total, session) => {
      const state =
        classChecks[`${weekKey}:${session.id}`] ??
        { classwork: false, homework: false };
      return total + Number(state.classwork) + Number(state.homework);
    }, 0);
    const totalChecks = dayClasses.length * 2;
    return {
      completedChecks,
      totalChecks,
      progress: totalChecks
        ? Math.round((completedChecks / totalChecks) * 100)
        : 0,
    };
  });

  function checkState(id: string) {
    return (
      classChecks[`${weekKey}:${id}`] ?? { classwork: false, homework: false }
    );
  }

  function toggleCheck(id: string, kind: "classwork" | "homework") {
    if (!weekKey) return;
    const key = `${weekKey}:${id}`;
    const currentlyCompleted = Boolean(classChecks[key]?.[kind]);
    setClassChecks((current) => {
      const entry = current[key] ?? { classwork: false, homework: false };
      return { ...current, [key]: { ...entry, [kind]: !entry[kind] } };
    });
    if (!currentlyCompleted && user) {
      trackChecklistCompletion(`schedule:${key}:${kind}`, "schedule", notify);
    }
  }

  function renderChecks(session: ClassSession) {
    const state = checkState(session.id);
    return (
      <div className="class-checks">
        <label className="check-chip">
          <input
            aria-label={`Classwork done for ${session.subject}`}
            checked={state.classwork}
            disabled={!weekKey}
            onChange={() => toggleCheck(session.id, "classwork")}
            type="checkbox"
          />
          <span>Classwork</span>
        </label>
        <label className="check-chip">
          <input
            aria-label={`Homework done for ${session.subject}`}
            checked={state.homework}
            disabled={!weekKey}
            onChange={() => toggleCheck(session.id, "homework")}
            type="checkbox"
          />
          <span>Homework</span>
        </label>
      </div>
    );
  }

  const startHour = classes.length
    ? Math.max(
        0,
        Math.min(
          8,
          Math.floor(
            Math.min(
              ...classes.map((session) =>
                minutesSinceMidnight(session.startTime),
              ),
            ) / 60,
          ),
        ),
      )
    : 8;
  const endHour = classes.length
    ? Math.min(
        24,
        Math.max(
          18,
          Math.ceil(
            Math.max(
              ...classes.map((session) =>
                minutesSinceMidnight(session.endTime),
              ),
            ) / 60,
          ),
        ),
      )
    : 18;
  const hours = Array.from(
    { length: endHour - startHour },
    (_, index) => startHour + index,
  );

  const weekOffsetLabel =
    weekOffset === 0
      ? "This week"
      : weekOffset === -1
        ? "Last week"
        : weekOffset === 1
          ? "Next week"
          : weekOffset < 0
            ? `${Math.abs(weekOffset)} weeks ago`
            : `In ${weekOffset} weeks`;

  return (
    <>
      <PageHeading
        action={
          <button
            className="primary-button"
            onClick={() => {
              setEditingId(null);
              setForm(emptyClassForm);
              setFormError("");
              setFormOpen((open) => !open);
            }}
            type="button"
          >
            <LuPlus size={16} /> Add a class
          </button>
        }
        eyebrow="Make room for learning"
        subtitle="Add each class with its day and times, then tick off classwork and homework as you finish them. Each week's checks are saved separately."
        title="Weekly schedule"
      />
      {formOpen && (
        <form className="panel form-panel" onSubmit={handleSubmit}>
          <h2 className="panel-title" style={{ marginBottom: 16 }}>
            {editingId ? "Update class" : "Add a class"}
          </h2>
          {!editingId && savedClasses.length > 0 && (
            <div className="saved-classes">
              <p className="saved-classes-label">
                Saved classes — tap one to fill the form, or × to remove the
                shortcut
              </p>
              <div className="saved-classes-list">
                {savedClasses.map((saved) => {
                  const added = existingSignatures.has(classSignature(saved));
                  return (
                    <div className="saved-class-item" key={saved.id}>
                      <button
                        className={`saved-class-chip${added ? " added" : ""}`}
                        onClick={() => applySavedClass(saved)}
                        type="button"
                      >
                        <strong>{saved.subject}</strong>
                        <span>
                          {added
                            ? "In schedule"
                            : `${shortWeekdays[saved.day]} · ${formatTime(saved.startTime)}`}
                        </span>
                      </button>
                      <button
                        aria-label={`Remove ${saved.subject} from saved classes`}
                        className="saved-class-remove"
                        onClick={() => removeSavedClass(saved.id)}
                        type="button"
                      >
                        <LuX size={12} />
                      </button>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
          <div className="form-grid">
            <div className="field">
              <label htmlFor="class-subject">Class name</label>
              <input
                autoFocus
                className="input"
                id="class-subject"
                list="class-subject-options"
                onChange={(event) =>
                  setForm({ ...form, subject: event.target.value })
                }
                placeholder="e.g. Biology"
                required
                value={form.subject}
              />
            </div>
            <div className="field">
              <label htmlFor="class-day">Day</label>
              <div className="select-wrap">
                <select
                  className="select"
                  id="class-day"
                  onChange={(event) =>
                    setForm({ ...form, day: event.target.value })
                  }
                  value={form.day}
                >
                  {weekdays.map((day, index) => (
                    <option key={day} value={index}>
                      {day}
                    </option>
                  ))}
                </select>
                <span aria-hidden="true" className="select-chevron">
                  <LuChevronDown size={15} strokeWidth={2.5} />
                </span>
              </div>
            </div>
            <div className="field">
              <label htmlFor="class-start">Starts</label>
              <input
                className="input"
                id="class-start"
                onChange={(event) =>
                  setForm({ ...form, startTime: event.target.value })
                }
                required
                type="time"
                value={form.startTime}
              />
            </div>
            <div className="field">
              <label htmlFor="class-end">Ends</label>
              <input
                className="input"
                id="class-end"
                onChange={(event) =>
                  setForm({ ...form, endTime: event.target.value })
                }
                required
                type="time"
                value={form.endTime}
              />
            </div>
            <div className="field">
              <label htmlFor="class-location">Room or location</label>
              <input
                className="input"
                id="class-location"
                list="class-location-options"
                onChange={(event) =>
                  setForm({ ...form, location: event.target.value })
                }
                placeholder="e.g. Room 204"
                value={form.location}
              />
            </div>
            <div className="field">
              <label htmlFor="class-instructor">Teacher</label>
              <input
                className="input"
                id="class-instructor"
                list="class-instructor-options"
                onChange={(event) =>
                  setForm({ ...form, instructor: event.target.value })
                }
                placeholder="Optional"
                value={form.instructor}
              />
            </div>
          </div>
          <datalist id="class-subject-options">
            {subjectOptions.map((option) => (
              <option key={option} value={option} />
            ))}
          </datalist>
          <datalist id="class-location-options">
            {locationOptions.map((option) => (
              <option key={option} value={option} />
            ))}
          </datalist>
          <datalist id="class-instructor-options">
            {instructorOptions.map((option) => (
              <option key={option} value={option} />
            ))}
          </datalist>
          {formError && (
            <p aria-live="polite" className="notice" style={{ marginTop: 13 }}>
              {formError}
            </p>
          )}
          <div className="form-actions">
            <button
              className="secondary-button"
              onClick={closeForm}
              type="button"
            >
              Cancel
            </button>
            <button className="primary-button" type="submit">
              {editingId ? "Save changes" : "Add class"}
            </button>
          </div>
        </form>
      )}

      <section aria-label="Weekly schedule" className="panel schedule-panel">
        <div className="week-toolbar">
          <button
            aria-label="Previous week"
            className="week-arrow"
            onClick={() => setWeekOffset((offset) => offset - 1)}
            type="button"
          >
            <LuChevronLeft size={18} />
          </button>
          <div className="week-caption">
            <strong>
              {viewedWeekStart ? formatWeekRange(viewedWeekStart) : "This week"}
            </strong>
            <span>{weekOffsetLabel}</span>
          </div>
          <button
            aria-label="Next week"
            className="week-arrow"
            onClick={() => setWeekOffset((offset) => offset + 1)}
            type="button"
          >
            <LuChevronRight size={18} />
          </button>
          {weekOffset !== 0 && (
            <button
              aria-label="Back to this week"
              className="text-button"
              onClick={() => {
                setWeekAnchor(toISODate(startOfWeek(new Date())));
                setWeekOffset(0);
              }}
              type="button"
            >
              This week
            </button>
          )}
        </div>

        {classes.length > 0 && (
          <div className="week-checklist">
            <div className="week-checklist-inner">
              <div className="checklist-head">
                <div className="checklist-heading-copy">
                  <h2>Classwork &amp; homework</h2>
                  <span>Separate checks for each week</span>
                </div>
                <div
                  aria-label={`${completedWeekChecks} of ${totalWeekChecks} weekly checks complete`}
                  className="checklist-week-progress"
                  role="progressbar"
                  aria-valuemax={totalWeekChecks}
                  aria-valuemin={0}
                  aria-valuenow={completedWeekChecks}
                >
                  <span className="checklist-week-progress-count">
                    <LuCircleCheck aria-hidden="true" size={14} />
                    {completedWeekChecks}/{totalWeekChecks} done
                  </span>
                  <span className="checklist-week-progress-track">
                    <span style={{ width: `${weekCheckProgress}%` }} />
                  </span>
                </div>
              </div>
              <div className="checklist-grid">
                {weekdays.map((day, index) => (
                  <div
                    className={`checklist-day${weekOffset === 0 && todayDay === index ? " today" : ""}`}
                    key={day}
                  >
                    <div className="checklist-day-heading">
                      <div>
                        <h3>{day}</h3>
                        <span className="checklist-day-date">
                          {dayDates[index]
                            ? new Intl.DateTimeFormat(undefined, {
                                month: "short",
                                day: "numeric",
                              }).format(dayDates[index])
                            : ""}
                        </span>
                      </div>
                      <span
                        className={`checklist-day-count${checklistDayStats[index].totalChecks > 0 && checklistDayStats[index].completedChecks === checklistDayStats[index].totalChecks ? " complete" : ""}`}
                      >
                        {checklistDayStats[index].completedChecks}/
                        {checklistDayStats[index].totalChecks}
                      </span>
                    </div>
                    <span className="checklist-day-progress">
                      <span
                        style={{
                          width: `${checklistDayStats[index].progress}%`,
                        }}
                      />
                    </span>
                    {classesByDay[index].length ? (
                      classesByDay[index].map((session) => (
                        <div className="checklist-row" key={session.id}>
                          <div className="checklist-class">
                            <span>{session.subject}</span>
                            <small>{formatTime(session.startTime)}</small>
                          </div>
                          {renderChecks(session)}
                        </div>
                      ))
                    ) : (
                      <p className="checklist-empty">No classes</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        <div
          className="timetable"
          data-hover-day={expandedDay ?? undefined}
          style={
            {
              "--hour-height": `${HOUR_HEIGHT}px`,
              "--hour-count": endHour - startHour,
            } as CSSProperties
          }
        >
          <div className="timetable-head">
            <div aria-hidden="true" className="timetable-corner" />
            {weekdays.map((day, index) => (
              <div
                className={`timetable-day${weekOffset === 0 && todayDay === index ? " today" : ""}${expandedDay === index ? " is-hovered" : ""}`}
                key={day}
                onMouseEnter={() => setHoverDay(index)}
                onMouseLeave={() => setHoverDay(null)}
              >
                <span>{shortWeekdays[index]}</span>
                <small>
                  {dayDates[index]
                    ? new Intl.DateTimeFormat(undefined, {
                        month: "short",
                        day: "numeric",
                      }).format(dayDates[index])
                    : ""}
                </small>
              </div>
            ))}
          </div>
          <div className="timetable-body">
            <div aria-hidden="true" className="time-scale">
              {hours.map((hour) => (
                <div className="time-slot" key={hour}>
                  {formatHour(hour)}
                </div>
              ))}
            </div>
            {weekdays.map((day, index) => {
              return (
                <div
                  aria-label={day}
                  className={`day-lane${weekOffset === 0 && todayDay === index ? " today" : ""}`}
                  key={day}
                  onMouseEnter={() => setHoverDay(index)}
                  onMouseLeave={() => setHoverDay(null)}
                  role="group"
                >
                  {classesByDay[index].map((session) => {
                    const state = checkState(session.id);
                    const complete = state.classwork && state.homework;
                    const start = minutesSinceMidnight(session.startTime);
                    const end = minutesSinceMidnight(session.endTime);
                    const top =
                      ((start - startHour * 60) / 60) * HOUR_HEIGHT;
                    const height = Math.max(
                      ((end - start) / 60) * HOUR_HEIGHT - 4,
                      4,
                    );
                    const layout = classLayoutsByDay[index].get(session.id) ?? {
                      column: 0,
                      columnCount: 1,
                      overlapCount: 0,
                    };
                    const columnWidth = 100 / layout.columnCount;
                    const overlapDescription = layout.overlapCount
                      ? `Overlaps with ${layout.overlapCount} other ${layout.overlapCount === 1 ? "class" : "classes"}.`
                      : undefined;
                    return (
                      <article
                        className={`time-block${complete ? " complete" : ""}${layout.overlapCount ? " has-overlap" : ""}${height < 58 ? " compact" : ""}${height < 100 ? " tight" : ""}${layout.columnCount > 2 ? " dense" : ""}${activeBlock?.id === session.id ? " is-open" : ""}`}
                        key={session.id}
                        style={{
                          height: `${height}px`,
                          top: `${top}px`,
                          left: `calc(${layout.column * columnWidth}% + 4px)`,
                          right: "auto",
                          width: `calc(${columnWidth}% - 8px)`,
                        }}
                        onClick={(event) => {
                          // Pressing the pencil/bin keeps its own behaviour.
                          if ((event.target as Element).closest(".block-action"))
                            return;
                          openDetails(session.id, event.currentTarget);
                        }}
                        onKeyDown={(event) => {
                          if (event.target !== event.currentTarget) return;
                          if (event.key === "Enter" || event.key === " ") {
                            event.preventDefault();
                            openDetails(session.id, event.currentTarget);
                          }
                        }}
                        onMouseEnter={clearPopoverTimer}
                        onMouseLeave={scheduleCloseDetails}
                        tabIndex={0}
                        title={overlapDescription}
                      >
                        <div className="time-block-head">
                          <span className="time-block-title">
                            {session.subject}
                          </span>
                          <span className="time-block-actions">
                            <button
                              aria-label={`Edit ${session.subject}`}
                              className="block-action"
                              onClick={() => startEditing(session)}
                              type="button"
                            >
                              <LuPencil size={12} />
                            </button>
                            <button
                              aria-label={`Delete ${session.subject}`}
                              className="block-action danger"
                              onClick={() => setDeleteId(session.id)}
                              type="button"
                            >
                              <LuTrash2 size={12} />
                            </button>
                          </span>
                        </div>
                        <span className="time-block-time">
                          {formatTime(session.startTime)} –{" "}
                          {formatTime(session.endTime)}
                          {session.location ? ` · ${session.location}` : ""}
                        </span>
                        {layout.overlapCount > 0 && (
                          <span
                            aria-label={overlapDescription}
                            className="time-block-conflict"
                          >
                            <LuCircleAlert aria-hidden="true" size={11} />
                            {layout.overlapCount} conflict
                            {layout.overlapCount === 1 ? "" : "s"}
                          </span>
                        )}
                      </article>
                    );
                  })}
                </div>
              );
            })}
          </div>
        </div>

        <div className="week-grid">
          {classes.length > 0 && (
            <div
              aria-label={`${completedWeekChecks} of ${totalWeekChecks} weekly checks complete`}
              className="mobile-week-progress"
              role="progressbar"
              aria-valuemax={totalWeekChecks}
              aria-valuemin={0}
              aria-valuenow={completedWeekChecks}
            >
              <div className="mobile-week-progress-heading">
                <strong>Classwork &amp; homework</strong>
                <span>
                  {completedWeekChecks}/{totalWeekChecks} done
                </span>
              </div>
              <span className="mobile-week-progress-track">
                <span style={{ width: `${weekCheckProgress}%` }} />
              </span>
            </div>
          )}
          {weekdays.map((day, index) => {
            const dayClasses = classesByDay[index];
            const overlap = hasOverlap(dayClasses);
            const overlappingCount = dayClasses.filter(
              (session) =>
                (classLayoutsByDay[index].get(session.id)?.overlapCount ?? 0) >
                0,
            ).length;
            return (
              <div
                className={`day-column${todayDay === index && weekOffset === 0 ? " today" : ""}`}
                key={day}
              >
                <div className="day-heading">
                  <div className="day-heading-copy">
                    <span>{day}</span>
                    <small>
                      {dayDates[index]
                        ? new Intl.DateTimeFormat(undefined, {
                            month: "short",
                            day: "numeric",
                          }).format(dayDates[index])
                        : ""}
                    </small>
                  </div>
                  <div className="day-heading-counts">
                    <span className="day-count">
                      {dayClasses.length}{" "}
                      {dayClasses.length === 1 ? "class" : "classes"}
                    </span>
                    <span
                      className={`mobile-day-check-count${checklistDayStats[index].totalChecks > 0 && checklistDayStats[index].completedChecks === checklistDayStats[index].totalChecks ? " complete" : ""}`}
                    >
                      {checklistDayStats[index].completedChecks}/
                      {checklistDayStats[index].totalChecks} done
                    </span>
                  </div>
                </div>
                {checklistDayStats[index].totalChecks > 0 && (
                  <span
                    aria-label={`${checklistDayStats[index].completedChecks} of ${checklistDayStats[index].totalChecks} ${day} checks complete`}
                    className="mobile-day-progress"
                    role="progressbar"
                    aria-valuemax={checklistDayStats[index].totalChecks}
                    aria-valuemin={0}
                    aria-valuenow={checklistDayStats[index].completedChecks}
                  >
                    <span
                      style={{
                        width: `${checklistDayStats[index].progress}%`,
                      }}
                    />
                  </span>
                )}
                {dayClasses.length ? (
                  dayClasses.map((session) => (
                    <article
                      className={`day-class${activeBlock?.id === session.id ? " is-open" : ""}`}
                      key={session.id}
                      onClick={(event) => {
                        // Checkboxes and the pencil/bin keep their own behaviour.
                        if (
                          (event.target as Element).closest(
                            "button, label, input, a",
                          )
                        )
                          return;
                        openDetails(session.id, event.currentTarget);
                      }}
                      onKeyDown={(event) => {
                        if (event.target !== event.currentTarget) return;
                        if (event.key === "Enter" || event.key === " ") {
                          event.preventDefault();
                          openDetails(session.id, event.currentTarget);
                        }
                      }}
                      onMouseEnter={clearPopoverTimer}
                      onMouseLeave={scheduleCloseDetails}
                      tabIndex={0}
                    >
                      <div className="day-class-title">{session.subject}</div>
                      <div className="day-class-time">
                        {formatTime(session.startTime)} –{" "}
                        {formatTime(session.endTime)}
                      </div>
                      {session.location && (
                        <div className="day-class-location">
                          {session.location}
                        </div>
                      )}
                      {renderChecks(session)}
                      <div className="inline-actions" style={{ marginTop: 8 }}>
                        <button
                          aria-label={`Edit ${session.subject}`}
                          className="small-icon-button"
                          onClick={() => startEditing(session)}
                          type="button"
                        >
                          <LuPencil size={13} />
                        </button>
                        <button
                          aria-label={`Delete ${session.subject}`}
                          className="small-icon-button danger"
                          onClick={() => setDeleteId(session.id)}
                          type="button"
                        >
                          <LuTrash2 size={13} />
                        </button>
                      </div>
                    </article>
                  ))
                ) : (
                  <div className="day-empty">Nothing planned</div>
                )}
                {overlap && (
                  <span className="overlap-badge">
                    <LuCircleAlert size={12} /> {overlappingCount} classes
                    overlap
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </section>

      <p className="page-subtitle" style={{ marginTop: 14 }}>
        {classes.length
          ? `${classes.length} ${classes.length === 1 ? "class" : "classes"} planned each week. Classwork and homework checks are saved separately for each week.`
          : "Your schedule is saved on this device, so you can come back and update it anytime."}
      </p>

      {deleteId && (
        <ConfirmDialog
          copy="This class will be removed from your weekly schedule."
          onCancel={() => setDeleteId(null)}
          onConfirm={() => {
            deleteClass(deleteId);
            setDeleteId(null);
            notify("Class removed.");
          }}
          title="Delete this class?"
        />
      )}

      {activeBlock &&
        !deleteId &&
        !formOpen &&
        (() => {
          const session = classes.find((item) => item.id === activeBlock.id);
          if (!session) return null;
          const overlapCount =
            classLayoutsByDay[session.day]?.get(session.id)?.overlapCount ?? 0;
          return createPortal(
            <ClassDetailsPopover
              anchor={activeBlock.rect}
              checks={renderChecks(session)}
              onDelete={() => {
                closeDetails();
                setDeleteId(session.id);
              }}
              onEdit={() => {
                closeDetails();
                startEditing(session);
              }}
              onPointerEnter={clearPopoverTimer}
              onPointerLeave={scheduleCloseDetails}
              overlapCount={overlapCount}
              session={session}
            />,
            document.body,
          );
        })()}
    </>
  );
}

/**
 * Read-only details card for one timetable subject. It floats beside the
 * subject (no backdrop, nothing behind it changes) and stays open for as long
 * as the pointer is over the subject or over the card itself.
 */
function ClassDetailsPopover({
  anchor,
  checks,
  onDelete,
  onEdit,
  onPointerEnter,
  onPointerLeave,
  overlapCount,
  session,
}: {
  anchor: DOMRect;
  checks: ReactNode;
  onDelete: () => void;
  onEdit: () => void;
  onPointerEnter: () => void;
  onPointerLeave: () => void;
  overlapCount: number;
  session: ClassSession;
}) {
  const ref = useRef<HTMLDivElement>(null);

  // Place it to the right of the subject, flip left near the screen edge, and
  // keep it fully inside the viewport. Done before paint, so it never jumps.
  useLayoutEffect(() => {
    const element = ref.current;
    if (!element) return;
    const { width, height } = element.getBoundingClientRect();
    const gap = 2;
    const margin = 8;
    let left = anchor.right + gap;
    if (left + width > window.innerWidth - margin) {
      left = Math.max(margin, anchor.left - gap - width);
    }
    let top = anchor.top;
    if (top + height > window.innerHeight - margin) {
      top = Math.max(margin, window.innerHeight - margin - height);
    }
    element.style.left = `${left}px`;
    element.style.top = `${top}px`;
    element.style.visibility = "visible";
  }, [anchor]);

  const minutes =
    minutesSinceMidnight(session.endTime) -
    minutesSinceMidnight(session.startTime);
  const duration =
    minutes > 0
      ? `${minutes >= 60 ? `${Math.floor(minutes / 60)} h ` : ""}${
          minutes % 60 ? `${minutes % 60} min` : ""
        }`.trim()
      : "";

  return (
    <div
      aria-label={`${session.subject} details`}
      className="class-popover"
      onPointerEnter={onPointerEnter}
      onPointerLeave={(event) => {
        // Fingers "leave" on lift-off; only a real mouse leaving should close it.
        if (event.pointerType === "mouse") onPointerLeave();
      }}
      ref={ref}
      role="dialog"
      style={{ left: 0, top: 0, visibility: "hidden" }}
    >
      <div className="class-popover-head">
        <h3 className="class-popover-title">{session.subject}</h3>
        <span className="class-popover-day">{weekdays[session.day]}</span>
      </div>
      <dl className="class-popover-list">
        <div>
          <dt>Time</dt>
          <dd>
            {formatTime(session.startTime)} – {formatTime(session.endTime)}
            {duration ? ` (${duration})` : ""}
          </dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{session.location || "Not added"}</dd>
        </div>
        <div>
          <dt>Instructor</dt>
          <dd>{session.instructor || "Not added"}</dd>
        </div>
        {overlapCount > 0 && (
          <div>
            <dt>Conflict</dt>
            <dd>
              Overlaps with {overlapCount} other{" "}
              {overlapCount === 1 ? "class" : "classes"}
            </dd>
          </div>
        )}
      </dl>
      {checks}
      <div className="class-popover-actions">
        <button className="secondary-button" onClick={onEdit} type="button">
          <LuPencil aria-hidden="true" size={13} /> Edit
        </button>
        <button
          className="secondary-button class-popover-delete"
          onClick={onDelete}
          type="button"
        >
          <LuTrash2 aria-hidden="true" size={13} /> Delete
        </button>
      </div>
    </div>
  );
}

