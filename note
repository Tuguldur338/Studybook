type NotifyFn = (message: string, type?: "success" | "error" | "info") => void;

function notifyPointsResult(
  result: Awaited<ReturnType<typeof awardTaskPoints>>,
  notify: NotifyFn,
) {
  if (!result.ok) {
    if (result.message) notify(result.message, "error");
    return;
  }

  notify(`${result.delta > 0 ? "+" : ""}${result.delta} leaderboard points.`);
}

function saveCompletedTask(
  task: StudyTask,
  completedLate: boolean,
  completedAt: string,
  userId: string | null,
  notify: NotifyFn,
) {
  if (!userId) return;

  let supabase: ReturnType<typeof getSupabaseBrowserClient>;
  try {
    supabase = getSupabaseBrowserClient();
  } catch (cause) {
    notify(
      `Could not connect your completed task to your account: ${borderDropErrorMessage(cause)}`,
      "error",
    );
    return;
  }
  void recordCompletedTask(supabase, {
    ...task,
    completedLate,
    completedAt,
  })
    .then((borders) => {
      window.dispatchEvent(new Event("studybook:task-history-updated"));
      if (borders.length) {
        notify(`You found the ${borders.map(borderLabel).join(" and ")} border!`);
        window.dispatchEvent(new Event("studybook:borders-updated"));
      }
    })
    .catch((cause: unknown) => {
      notify(
        `Could not save completed task: ${borderDropErrorMessage(cause)}`,
        "error",
      );
    });

  void recordCompletionEvent(supabase, `todo:${task.id}`, "todo")
    .then(({ unlockedAchievement }) => {
      if (unlockedAchievement === TASK_COMPLETION_ACHIEVEMENT_ID) {
        notify("Achievement unlocked: 50 tasks completed!");
      }
    })
    .catch((cause: unknown) => {
      notify(
        `Could not update achievement progress: ${achievementErrorMessage(cause)}`,
        "error",
      );
    });
}

function trackChecklistCompletion(
  eventKey: string,
  source: Exclude<CompletionSource, "todo">,
  notify: NotifyFn,
) {
  void (async () => {
    try {
      const { unlockedAchievement } = await recordCompletionEvent(
        getSupabaseBrowserClient(),
        eventKey,
        source,
      );
      if (unlockedAchievement === TASK_COMPLETION_ACHIEVEMENT_ID) {
        notify("Achievement unlocked: 50 tasks completed!");
      }
    } catch (cause) {
      notify(
        `Could not update achievement progress: ${achievementErrorMessage(cause)}`,
        "error",
      );
    }
  })();
}

function toISODate(date: Date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

function isOverdue(task: StudyTask, todayStr: string) {
  return !task.completed && !!task.dueDate && task.dueDate < todayStr;
}

function getTaskPriority(
  task: Pick<StudyTask, "dueDate"> &
    Partial<Pick<StudyTask, "completed" | "priority">>,
  todayStr: string,
): StudyTask["priority"] {
  if (task.completed && task.priority) return task.priority;
  if (!task.dueDate) return "low";

  const today = todayStr || toISODate(new Date());
  const dueTime = Date.parse(`${task.dueDate}T00:00:00Z`);
  const todayTime = Date.parse(`${today}T00:00:00Z`);
  if (Number.isNaN(dueTime) || Number.isNaN(todayTime)) return "low";

  const daysUntilDue = Math.ceil((dueTime - todayTime) / 86_400_000);
  if (daysUntilDue <= 3) return "high";
  if (daysUntilDue <= 7) return "medium";
  return "low";
}

function getGreeting(hour: number) {
  if (hour < 5) return "Working late";
  if (hour < 12) return "Good morning";
  if (hour < 18) return "Good afternoon";
  return "Good evening";
}

function formatTime(value: string) {
  const [hours, minutes] = value.split(":").map(Number);
  const date = new Date(2020, 0, 1, hours, minutes);
  return new Intl.DateTimeFormat(undefined, {
    hour: "numeric",
    minute: "2-digit",
  }).format(date);
}

function formatDate(value: string) {
  if (!value) return "No due date";
  const date = new Date(`${value}T00:00:00`);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat(undefined, {
    month: "short",
    day: "numeric",
  }).format(date);
}

function hasOverlap(list: ClassSession[]) {
  return list.some((session, index) =>
    list.some(
      (other, otherIndex) =>
        otherIndex > index &&
        session.startTime < other.endTime &&
        other.startTime < session.endTime,
    ),
  );
}

function layoutDayClasses(list: ClassSession[]) {
  const layouts = new Map<
    string,
    { column: number; columnCount: number; overlapCount: number }
  >();
  const sorted = [...list].sort(
    (a, b) =>
      a.startTime.localeCompare(b.startTime) ||
      a.endTime.localeCompare(b.endTime),
  );
  let group: ClassSession[] = [];
  let groupEnd = "";

  function placeGroup() {
    if (!group.length) return;

    const columnEnds: string[] = [];
    const columns = new Map<string, number>();
    for (const session of group) {
      let column = columnEnds.findIndex(
        (columnEnd) => columnEnd <= session.startTime,
      );
      if (column === -1) column = columnEnds.length;
      columnEnds[column] = session.endTime;
      columns.set(session.id, column);
    }

    for (const session of group) {
      const overlapCount = group.reduce(
        (count, other) =>
          count +
          Number(
            other.id !== session.id &&
              session.startTime < other.endTime &&
              other.startTime < session.endTime,
          ),
        0,
      );
      layouts.set(session.id, {
        column: columns.get(session.id) ?? 0,
        columnCount: columnEnds.length,
        overlapCount,
      });
    }

    group = [];
    groupEnd = "";
  }

  for (const session of sorted) {
    if (group.length && session.startTime >= groupEnd) placeGroup();
    group.push(session);
    if (session.endTime > groupEnd) groupEnd = session.endTime;
  }
  placeGroup();

  return layouts;
}

const HOUR_HEIGHT = 64;

function startOfWeek(date: Date) {
  const monday = new Date(date);
  monday.setDate(monday.getDate() - ((monday.getDay() + 6) % 7));
  monday.setHours(0, 0, 0, 0);
  return monday;
}

function addDays(date: Date, days: number) {
  const next = new Date(date);
  next.setDate(next.getDate() + days);
  return next;
}

function minutesSinceMidnight(value: string) {
  const [hours, minutes] = value.split(":").map(Number);
  return hours * 60 + minutes;
}

function classSignature(
  value: Pick<
    ClassSession,
    "subject" | "day" | "startTime" | "endTime" | "location" | "instructor"
  >,
) {
  return [
    value.subject.trim().toLowerCase(),
    value.day,
    value.startTime,
    value.endTime,
    value.location.trim().toLowerCase(),
    value.instructor.trim().toLowerCase(),
  ].join("|");
}

function formatWeekRange(start: Date) {
  const format = (date: Date) =>
    new Intl.DateTimeFormat(undefined, {
      month: "short",
      day: "numeric",
    }).format(date);
  return `${format(start)} – ${format(addDays(start, 4))}`;
}

function formatHour(hour: number) {
  const suffix = hour < 12 ? "AM" : "PM";
  const display = hour % 12 === 0 ? 12 : hour % 12;
  return `${display} ${suffix}`;
}

function PageHeading({
  eyebrow,
  title,
  subtitle,
  action,
}: {
  eyebrow: string;
  title: string;
  subtitle: string;
  action?: ReactNode;
}) {
  return (
    <div className="page-heading">
      <div>
        <p className="eyebrow">{eyebrow}</p>
        <h1 className="page-title">{title}</h1>
        <p className="page-subtitle">{subtitle}</p>
      </div>
      {action}
    </div>
  );
}

function EmptyState({
  icon,
  title,
  copy,
}: {
  icon: ReactNode;
  title: string;
  copy: string;
}) {
  return (
    <div className="empty-state">
      <div>
        <span className="empty-state-icon">{icon}</span>
        <p className="empty-state-title">{title}</p>
        <p className="empty-state-copy">{copy}</p>
      </div>
    </div>
  );
}

function ClassRow({ session }: { session: ClassSession }) {
  return (
    <div className="class-row">
      <div className="class-time">
        {formatTime(session.startTime)}
        <br />
        {formatTime(session.endTime)}
      </div>
      <span className="class-color" />
      <div>
        <div className="class-name">{session.subject}</div>
        <div className="class-location">
          {[session.location, session.instructor].filter(Boolean).join(" · ") ||
            "Class details not added"}
        </div>
      </div>
      <div className="class-day">{shortWeekdays[session.day]}</div>
    </div>
  );
}

function ConfirmDialog({
  title,
  copy,
  confirmLabel = "Delete",
  onCancel,
  onConfirm,
}: {
  title: string;
  copy: string;
  confirmLabel?: string;
  onCancel: () => void;
  onConfirm: () => void;
}) {
  return (
    <div className="modal-backdrop" onClick={onCancel} role="presentation">
      <section
        aria-modal="true"
        className="modal confirm-dialog"
        onClick={(event) => event.stopPropagation()}
        role="alertdialog"
      >
        <span className="confirm-icon">
          <LuTrash2 size={22} />
        </span>
        <h2 className="confirm-title">{title}</h2>
        <p className="confirm-copy">{copy}</p>
        <div className="confirm-actions">
          <button className="secondary-button" onClick={onCancel} type="button">
            Cancel
          </button>
          <button
            className="primary-button danger-button"
            onClick={onConfirm}
            type="button"
          >
            {confirmLabel}
          </button>
        </div>
      </section>
    </div>
  );
}
export default function DashboardView() {
  const { classes, notes, notify, profile, setTasks, tasks } = useStudybook();
  const { user } = useSupabaseUser();
  const [today, setToday] = useState<{ day: number; label: string } | null>(
    null,
  );
  const [greeting, setGreeting] = useState("Welcome");
  const [todayStr, setTodayStr] = useState("");

  useEffect(() => {
    const updateToday = () => {
      const now = new Date();
      setToday({
        day: (now.getDay() + 6) % 7,
        label: new Intl.DateTimeFormat(undefined, {
          weekday: "long",
          month: "long",
          day: "numeric",
        }).format(now),
      });
      setGreeting(getGreeting(now.getHours()));
      setTodayStr(toISODate(now));
    };
    const frame = window.requestAnimationFrame(updateToday);
    const interval = window.setInterval(updateToday, 30_000);
    return () => {
      window.cancelAnimationFrame(frame);
      window.clearInterval(interval);
    };
  }, []);

  const todaysClasses =
    today && today.day < 5
      ? classes
          .filter((session) => session.day === today.day)
          .sort((a, b) => a.startTime.localeCompare(b.startTime))
      : [];

  const pendingTasks = tasks.filter((task) => !task.completed);
  const completedCount = tasks.length - pendingTasks.length;
  const progress =
    tasks.length === 0 ? 0 : Math.round((completedCount / tasks.length) * 100);
  const overdueCount = pendingTasks.filter((task) =>
    isOverdue(task, todayStr),
  ).length;

  const nextTasks = [...pendingTasks]
    .sort((a, b) => {
      if (!a.dueDate) return 1;
      if (!b.dueDate) return -1;
      return a.dueDate.localeCompare(b.dueDate);
    })
    .slice(0, 3);

  const firstName = profile.name.trim().split(/\s+/)[0] || "student";

  function completeTask(task: StudyTask) {
    const changedAt = new Date().toISOString();
    const late = isOverdue(task, todayStr);
    const taskAtCompletion = {
      ...task,
      priority: getTaskPriority(task, todayStr),
    };
    setTasks((current) =>
      current.map((item) =>
        item.id === task.id
          ? {
              ...item,
              completed: true,
              completedLate: late,
              priority: taskAtCompletion.priority,
              updatedAt: changedAt,
            }
          : item,
      ),
    );
    saveCompletedTask(taskAtCompletion, late, changedAt, user?.id ?? null, notify);
    void awardTaskPoints(taskAtCompletion.priority, 1, late).then((result) =>
      notifyPointsResult(result, notify),
    );
  }

  return (
    <>
      <section className="welcome-card">
        <div className="welcome-decor" aria-hidden="true" />
        <div className="welcome-content">
          <p className="welcome-kicker">
            {greeting} · {today?.label ?? "Your study week"}
          </p>
          <h1 className="welcome-title">Hey, {firstName}.</h1>
          <p className="welcome-copy">
            A fresh page, a clear plan, and a little progress at a time. Your
            study week starts here.
          </p>
          <Link className="primary-button" href="/schedule">
            View my schedule{" "}
            <span className="arrow-icon">
              <LuArrowRight aria-hidden="true" size={14} />
            </span>
          </Link>
        </div>
      </section>

      <section aria-label="Studybook summary" className="stats-grid">
        <div className="stat-card">
          <span className="stat-icon">
            <LuCalendarDays aria-hidden="true" size={20} />
          </span>
          <div>
            <div className="stat-label">Classes this week</div>
            <div className="stat-value">{classes.length}</div>
            <div className="stat-note">Your weekly rhythm</div>
          </div>
        </div>
        <div className="stat-card">
          <span className="stat-icon">
            <LuCircleCheck aria-hidden="true" size={20} />
          </span>
          <div>
            <div className="stat-label">To-dos to finish</div>
            <div className="stat-value stat-value-with-overdue">
              {pendingTasks.length}
              {overdueCount > 0 && (
                <span
                  aria-label={`${overdueCount} overdue tasks`}
                  className="overdue-count"
                >
                  {overdueCount} overdue
                </span>
              )}
            </div>
            <div className="stat-note">
              {pendingTasks.length === 1 ? "One step at a time" : "Keep it up"}
            </div>
          </div>
        </div>
        <div className="stat-card">
          <span className="stat-icon">
            <LuNotebookPen aria-hidden="true" size={20} />
          </span>
          <div>
            <div className="stat-label">Study notes</div>
            <div className="stat-value">{notes.length}</div>
            <div className="stat-note">Ideas worth keeping</div>
          </div>
        </div>
      </section>
      <section
        className="panel"
        style={{ marginBottom: 16, padding: "20px 22px" }}
      >
        <div className="panel-heading" style={{ padding: 0 }}>
          <h2 className="panel-title">Your progress</h2>
          <span className="panel-link">
            {completedCount} of {tasks.length} tasks done
          </span>
        </div>
        <div className="progress-wrap">
          <div className="progress-track">
            <div className="progress-fill" style={{ width: `${progress}%` }} />
          </div>
        </div>
      </section>

      <ExamReminder />

      <div className="dashboard-grid">
        <section className="panel">
          <div className="panel-heading">
            <h2 className="panel-title">Today&apos;s classes</h2>
            <Link className="panel-link" href="/schedule">
              Full schedule{" "}
              <span className="arrow-icon">
                <LuArrowRight aria-hidden="true" size={13} />
              </span>
            </Link>
          </div>
          <div className="panel-body">
            {todaysClasses.length ? (
              <div className="schedule-list">
                {todaysClasses.map((session) => (
                  <ClassRow key={session.id} session={session} />
                ))}
              </div>
            ) : (
              <EmptyState
                copy={
                  classes.length
                    ? "There are no classes on your schedule today."
                    : "Add your classes to see your day at a glance."
                }
                icon={<LuCalendarPlus aria-hidden="true" size={22} />}
                title={
                  classes.length
                    ? "No classes today"
                    : "Your schedule starts here"
                }
              />
            )}
          </div>
        </section>

        <section className="panel">
          <div className="panel-heading">
            <h2 className="panel-title">Next up</h2>
            <Link className="panel-link" href="/to-do-list">
              All tasks{" "}
              <span className="arrow-icon">
                <LuArrowRight aria-hidden="true" size={13} />
              </span>
            </Link>
          </div>
          <div className="panel-body">
            {nextTasks.length ? (
              <div className="task-list">
                {nextTasks.map((task) => {
                  const overdue = isOverdue(task, todayStr);
                  const priority = getTaskPriority(task, todayStr);
                  return (
                    <div
                      className={`task-row${overdue ? " overdue" : ""}`}
                      key={task.id}
                    >
                      <button
                        aria-label={`Complete ${task.title}`}
                        className="task-check dashboard-task-check"
                        onClick={() => completeTask
